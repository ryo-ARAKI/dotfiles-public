# ~/.bashrc_remote
# Keep Bash minimal on remote hosts and hand off interactive use to Fish.

if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

export LC_ALL=en_US.UTF-8

# Optional remote-specific environment.
# export PATH="/path/to/bin${PATH:+:$PATH}"
# export LD_LIBRARY_PATH="/path/to/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# export MODULEPATH="/path/to/modulefiles${MODULEPATH:+:$MODULEPATH}"

# Make Node and Codex available to non-interactive SSH commands.
if ! command -v codex >/dev/null 2>&1; then
    while IFS= read -r codex_node_bin; do
        if [ -x "$codex_node_bin/node" ] && [ -x "$codex_node_bin/codex" ]; then
            export PATH="$codex_node_bin:$PATH"
            break
        fi
    done < <(printf '%s\n' "$HOME"/.nvm/versions/node/v*/bin | sort -Vr)
    unset codex_node_bin
fi

case $- in
    *i*) ;;
      *) return ;;
esac

if command -v fish >/dev/null 2>&1; then
    exec fish
fi
