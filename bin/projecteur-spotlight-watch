#!/usr/bin/env python3
from __future__ import annotations

import subprocess
import time
from pathlib import Path


DEVICE_DIR = Path("/dev/input/by-id")
DEVICE_NAMES = {
    "usb-Logitech_USB_Receiver-event-if01",
    "usb-Logitech_USB_Receiver-if01-event-mouse",
    "usb-Logitech_USB_Receiver-if03-event-mouse",
}
POLL_SECONDS = 1.0


def spotlight_receiver_present() -> bool:
    return any((DEVICE_DIR / name).exists() for name in DEVICE_NAMES)


def start_projecteur() -> None:
    subprocess.run(["systemctl", "--user", "start", "projecteur.service"], check=False)


def main() -> int:
    was_present = spotlight_receiver_present()
    while True:
        time.sleep(POLL_SECONDS)
        is_present = spotlight_receiver_present()
        if is_present and not was_present:
            start_projecteur()
        was_present = is_present


if __name__ == "__main__":
    raise SystemExit(main())
