#!/usr/bin/env python3
import argparse
import os
import socket
import sys
from datetime import datetime
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover - Python < 3.11
    tomllib = None

ROOT = Path(__file__).resolve().parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from dotfiles_installer.apply import apply_entry
from dotfiles_installer.codex_agents import COMMON_FRAGMENT as CODEX_AGENTS_COMMON_FRAGMENT
from dotfiles_installer.codex_agents import apply_codex_agents
from dotfiles_installer.codex_agents import plan_codex_agents
from dotfiles_installer.codex_config import apply_codex_config
from dotfiles_installer.codex_config import plan_codex_config
from dotfiles_installer.codex_config import plan_codex_profile
from dotfiles_installer.codex_runtime import apply_codex_runtime
from dotfiles_installer.context import detect_context
from dotfiles_installer.manifest import ManifestEntry
from dotfiles_installer.manifest import load_manifest
from dotfiles_installer.planner import build_plan_report
from dotfiles_installer.reporting import (
    read_text_if_exists,
    render_text_diff,
    summarize_generated_line,
    summarize_overridden_line,
    summarize_plan_line,
    summarize_run,
)


def _matches_only(entry: ManifestEntry, only: str | None) -> bool:
    if not only:
        return True
    return only in entry.target or only in entry.source


def _resolve_host_name(explicit: str | None) -> str:
    return explicit or socket.gethostname()


def _matches_codex_only(only: str | None) -> bool:
    if not only:
        return True
    profile_names = ("quick.config.toml", "deep.config.toml", "subagent.config.toml", "reviewer.config.toml")
    if any(only in name for name in profile_names):
        return False
    candidates = (
        "config/codex/config.public.toml",
        "config/codex/config.private.toml",
        "~/.codex/config.toml",
        "~/.codex/quick.config.toml",
        "~/.codex/deep.config.toml",
        "~/.codex/subagent.config.toml",
        "~/.codex/reviewer.config.toml",
        "codex",
    )
    return any(only in candidate for candidate in candidates)


def _matches_codex_agents_only(only: str | None) -> bool:
    if not only:
        return True
    candidates = (
        "config/codex/AGENTS.common.md",
        "config/codex/AGENTS.local.extra.md",
        "~/.codex/AGENTS.md",
        "AGENTS.md",
    )
    return any(only in candidate for candidate in candidates)


def _should_plan_codex_agents(private_root: Path | None, only: str | None) -> bool:
    if private_root is None or not _matches_codex_agents_only(only):
        return False
    return only is not None or (private_root / CODEX_AGENTS_COMMON_FRAGMENT).exists()


def _resolve_repo_root(
    entry: ManifestEntry,
    *,
    base_root: Path,
    private_root: Path | None,
    host_root: Path | None,
) -> Path:
    if entry.layer == "private":
        if private_root is None:
            raise ValueError("private entry requested without private root")
        return private_root
    if entry.layer == "host":
        if host_root is None:
            raise ValueError("host entry requested without host root")
        return host_root
    return base_root


def _file_mode(path: Path) -> int | None:
    if not path.exists():
        return None
    return path.stat().st_mode & 0o777


def _report_codex_apply_failure(
    target: str,
    applied_targets: list[str],
    pending_targets: list[str],
    backup_root: Path,
    error: Exception,
) -> int:
    print(f"Codex apply failed for {target}: {type(error).__name__}", file=sys.stderr)
    print(
        "Previously applied targets: " + (", ".join(applied_targets) if applied_targets else "(none)"),
        file=sys.stderr,
    )
    print(
        "Codex targets not applied: " + (", ".join(pending_targets) if pending_targets else "(none)"),
        file=sys.stderr,
    )
    print(
        f"Backups: {backup_root}",
        file=sys.stderr,
    )
    return 1


def _render_entry_preview(entry, repo_root: Path, *, dry_run: bool) -> tuple[bool, str | None]:
    source_path = repo_root / entry.source
    target_path = Path(entry.target).expanduser()
    source_bytes = source_path.read_bytes()
    current_bytes = target_path.read_bytes() if target_path.exists() else None
    current_mode = _file_mode(target_path)
    desired_mode = int(entry.mode, 8)
    content_matches = current_bytes == source_bytes
    mode_matches = current_mode == desired_mode
    needs_change = not (content_matches and mode_matches)

    if dry_run:
        status = "nochange" if not needs_change else "would apply"
        return needs_change, f"{status}: {summarize_plan_line(entry)}"

    try:
        source_text = source_bytes.decode("utf-8")
        current_text = current_bytes.decode("utf-8") if current_bytes is not None else None
    except UnicodeDecodeError:
        lines = [summarize_plan_line(entry)]
        if not needs_change:
            lines.append("No changes needed")
            return needs_change, "\n".join(lines)

        lines.append(f"Binary file: {entry.target} <- {entry.source}")
        if content_matches and not mode_matches:
            lines.append(f"Mode change: {current_mode:04o} -> {desired_mode:04o}")
        return needs_change, "\n".join(lines)

    lines = [summarize_plan_line(entry)]
    if not needs_change:
        lines.append("No changes needed")
        return needs_change, "\n".join(lines)

    lines.append(render_text_diff(entry.target, entry.source, current_text, source_text))
    if current_text is not None and content_matches and not mode_matches:
        lines.append(f"Mode change: {current_mode:04o} -> {desired_mode:04o}")
    return needs_change, "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--context", choices=("local", "remote"))
    parser.add_argument("--private")
    parser.add_argument("--hosts")
    parser.add_argument("--host-name")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--only")
    parser.add_argument("--yes", action="store_true")
    args = parser.parse_args()

    if args.host_name and not args.hosts:
        parser.error("--host-name requires --hosts")

    context = detect_context(args.context, dict(os.environ))
    entries = load_manifest(ROOT / "manifest" / "base.tsv", "base")
    private_root = None
    host_root = None
    if args.private:
        private_root = Path(args.private).expanduser()
        entries += load_manifest(private_root / "manifest" / "private.tsv", "private")
    if args.hosts:
        host_root = Path(args.hosts).expanduser()
        resolved_host = _resolve_host_name(args.host_name)
        host_manifest = host_root / "manifest" / f"{resolved_host}.tsv"
        if not host_manifest.exists():
            parser.error(f"Host manifest not found: {host_manifest}")
        entries += load_manifest(host_manifest, "host")
    codex_plan = None
    if _matches_codex_only(args.only):
        try:
            codex_plan = plan_codex_config(ROOT, private_root, context=context)
        except ValueError as exc:
            parser.error(str(exc))
        except Exception as exc:
            if tomllib is not None and isinstance(exc, tomllib.TOMLDecodeError):
                parser.error(f"Generated Codex config is not valid TOML: {exc}")
            raise
    codex_agents_plan = None
    if _should_plan_codex_agents(private_root, args.only):
        try:
            codex_agents_plan = plan_codex_agents(private_root, context=context)
        except ValueError as exc:
            parser.error(str(exc))
    report = build_plan_report(entries, context=context)
    filtered_plan = {
        target: entry
        for target, entry in report.selected.items()
        if _matches_only(entry, args.only)
    }
    filtered_overridden: list[ManifestEntry] = []
    for _, overridden_entries in report.overridden.items():
        for entry in overridden_entries:
            if _matches_only(entry, args.only):
                filtered_overridden.append(entry)

    # Plan every selected Codex profile before any generic manifest write.
    codex_profiles = {}
    generic_plan = {}
    for target, entry in filtered_plan.items():
        target_path = Path(entry.target).expanduser()
        if target_path.parent == Path.home() / ".codex" and target_path.name.endswith(".config.toml"):
            repo_root = _resolve_repo_root(entry, base_root=ROOT, private_root=private_root, host_root=host_root)
            source_path = repo_root / entry.source
            codex_profiles[target] = (entry, plan_codex_profile(
                source_path.read_text(encoding="utf-8"),
                target_path=target_path,
                source_label=f"{entry.layer}: {entry.source}",
                target_label=entry.target,
            ))
        else:
            generic_plan[target] = entry

    backup_root = Path.home() / ".dotfiles-backup" / datetime.now().strftime("%Y%m%d-%H%M%S")
    applied = 0
    applied_targets: list[str] = []
    skipped = 0
    nochange = 0
    for entry in generic_plan.values():
        repo_root = _resolve_repo_root(entry, base_root=ROOT, private_root=private_root, host_root=host_root)
        needs_change, preview = _render_entry_preview(entry, repo_root=repo_root, dry_run=args.dry_run)
        print(preview)
        if not needs_change:
            nochange += 1
            continue
        if args.dry_run:
            continue
        apply_current = True
        if not args.yes:
            while True:
                answer = input("Apply this change? [y]es/[n]o/[q]uit/[a]ll: ").strip().lower()
                if answer == "y":
                    break
                if answer == "n":
                    apply_current = False
                    break
                if answer == "q":
                    print(summarize_run(applied, skipped, nochange, len(filtered_overridden), args.dry_run))
                    return 1
                if answer == "a":
                    args.yes = True
                    break
        if not apply_current:
            skipped += 1
            continue
        apply_entry(entry, repo_root=repo_root, backup_root=backup_root)
        applied += 1
        applied_targets.append(entry.target)
    if codex_plan is not None:
        try:
            codex_status = apply_codex_config(codex_plan, backup_root=backup_root, dry_run=True)
        except Exception as exc:
            pending = [codex_plan.target_label, *(plan.target_label for _, plan in codex_profiles.values())]
            if codex_agents_plan is not None:
                pending.append(codex_agents_plan.target_label)
            return _report_codex_apply_failure(codex_plan.target_label, applied_targets, pending, backup_root, exc)
        if codex_status == "would_apply" and not args.dry_run:
            if not args.yes:
                answer = input("Apply this Codex config change? [y]es/[n]o/[q]uit: ").strip().lower()
                if answer != "y":
                    skipped += 1
                    if answer == "q":
                        print(summarize_run(applied, skipped, nochange, len(filtered_overridden), args.dry_run))
                        return 1
                    codex_status = "skipped"
                else:
                    try:
                        codex_status = apply_codex_config(codex_plan, backup_root=backup_root, dry_run=False)
                    except Exception as exc:
                        pending = [codex_plan.target_label, *(plan.target_label for _, plan in codex_profiles.values())]
                        if codex_agents_plan is not None:
                            pending.append(codex_agents_plan.target_label)
                        return _report_codex_apply_failure(codex_plan.target_label, applied_targets, pending, backup_root, exc)
            else:
                try:
                    codex_status = apply_codex_config(codex_plan, backup_root=backup_root, dry_run=False)
                except Exception as exc:
                    pending = [codex_plan.target_label, *(plan.target_label for _, plan in codex_profiles.values())]
                    if codex_agents_plan is not None:
                        pending.append(codex_agents_plan.target_label)
                    return _report_codex_apply_failure(codex_plan.target_label, applied_targets, pending, backup_root, exc)
        if codex_status == "skipped":
            pass
        elif codex_status == "applied":
            applied += 1
            applied_targets.append(codex_plan.target_label)
        elif codex_status == "nochange":
            nochange += 1
        print(summarize_generated_line("codex", codex_plan.source_label, codex_plan.target_label, status=codex_status.replace("_", " ")))
        if codex_plan.runtime_plan.changed_keys:
            print("  managed settings changed: " + ", ".join(codex_plan.runtime_plan.changed_keys))
        if codex_plan.runtime_plan.preserved_keys:
            print("  existing settings retained: " + ", ".join(codex_plan.runtime_plan.preserved_keys))
    profile_targets = list(codex_profiles.items())
    for profile_index, (target, (profile_entry, profile_plan)) in enumerate(profile_targets):
        try:
            status = apply_codex_runtime(profile_plan, backup_root=backup_root, dry_run=True)
        except Exception as exc:
            pending = [plan.target_label for _, (_, plan) in profile_targets[profile_index:]]
            if codex_agents_plan is not None:
                pending.append(codex_agents_plan.target_label)
            return _report_codex_apply_failure(profile_plan.target_label, applied_targets, pending, backup_root, exc)
        if status == "would_apply" and not args.dry_run:
            if not args.yes:
                answer = input(f"Apply this Codex profile change ({profile_plan.target_label})? [y]es/[n]o/[q]uit: ").strip().lower()
                if answer != "y":
                    skipped += 1
                    if answer == "q":
                        print(summarize_run(applied, skipped, nochange, len(filtered_overridden), args.dry_run))
                        return 1
                    status = "skipped"
            if status == "would_apply":
                try:
                    status = apply_codex_runtime(profile_plan, backup_root=backup_root, dry_run=False)
                except Exception as exc:
                    pending = [plan.target_label for _, (_, plan) in profile_targets[profile_index:]]
                    if codex_agents_plan is not None:
                        pending.append(codex_agents_plan.target_label)
                    return _report_codex_apply_failure(profile_plan.target_label, applied_targets, pending, backup_root, exc)
        print(summarize_generated_line(profile_entry.layer, profile_entry.source, profile_entry.target, status=status.replace("_", " ")))
        if profile_plan.changed_keys:
            print("  managed settings changed: " + ", ".join(profile_plan.changed_keys))
        if profile_plan.preserved_keys:
            print("  existing settings retained: " + ", ".join(profile_plan.preserved_keys))
        if status == "applied":
            applied += 1
            applied_targets.append(profile_entry.target)
        elif status == "nochange":
            nochange += 1
    if codex_agents_plan is not None:
        codex_agents_status = apply_codex_agents(codex_agents_plan, backup_root=backup_root, dry_run=args.dry_run)
        print(
            summarize_generated_line(
                "codex-agents",
                codex_agents_plan.source_label,
                codex_agents_plan.target_label,
                status=codex_agents_status.replace("_", " "),
            )
        )
        if codex_agents_status == "applied":
            applied += 1
        if codex_agents_status == "nochange":
            nochange += 1
    for entry in filtered_overridden:
        if args.dry_run:
            print(summarize_overridden_line(entry))
    print(summarize_run(applied, skipped, nochange, len(filtered_overridden), args.dry_run))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
