#!/usr/bin/env python3
import argparse
import os
import socket
import sys
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from dotfiles_installer.apply import apply_entry
from dotfiles_installer.codex_agents import (
    COMMON_FRAGMENT, LOCAL_EXTRA_FRAGMENT, TARGET_PATH as CODEX_AGENTS_TARGET,
    plan_codex_agents,
)
from dotfiles_installer.codex_config import (
    PUBLIC_FRAGMENT, PRIVATE_FRAGMENT, PRIVATE_LOCAL_FRAGMENT,
    TARGET_PATH as CODEX_CONFIG_TARGET, plan_codex_config,
)
from dotfiles_installer.codex_runtime import CodexFilePlan, apply_codex_file, plan_codex_runtime
from dotfiles_installer.context import detect_context
from dotfiles_installer.manifest import ManifestEntry
from dotfiles_installer.manifest import load_manifest
from dotfiles_installer.planner import build_plan_report
from dotfiles_installer.settings_fragments import fragment_for, plan_private_settings
from dotfiles_installer.reporting import (
    render_text_diff,
    summarize_generated_line,
    summarize_overridden_line,
    summarize_plan_line,
    summarize_run,
)


def _matches_paths(only: str | None, *paths: str | Path) -> bool:
    return not only or any(only in str(path) for path in paths)


def _matches_only(entry: ManifestEntry, only: str | None) -> bool:
    return _matches_paths(only, entry.target, entry.source, fragment_for(entry) or "")


def _resolve_host_name(explicit: str | None) -> str:
    return explicit or socket.gethostname()


def _should_plan_codex_agents(private_root: Path | None, only: str | None) -> bool:
    if not _matches_paths(only, CODEX_AGENTS_TARGET, COMMON_FRAGMENT, LOCAL_EXTRA_FRAGMENT):
        return False
    return (
        (ROOT / COMMON_FRAGMENT).exists()
        or private_root is not None and (only is not None or (private_root / COMMON_FRAGMENT).exists())
    )


def _confirm_change(prompt: str) -> str:
    while True:
        answer = input(prompt).strip().lower()
        if answer in {"y", "n", "q", "a"}:
            return answer


def _resolve_repo_root(
    entry: ManifestEntry,
    *,
    base_root: Path,
    private_root: Path | None,
    host_root: Path | None,
) -> Path:
    if entry.layer == "private":
        if private_root is None:
            raise ValueError("private entry requested without private root")
        return private_root
    if entry.layer == "host":
        if host_root is None:
            raise ValueError("host entry requested without host root")
        return host_root
    return base_root


def _file_mode(path: Path) -> int | None:
    if not path.exists():
        return None
    return path.stat().st_mode & 0o777


def _report_codex_apply_failure(
    target: str,
    applied_targets: list[str],
    pending_targets: list[str],
    backup_root: Path,
    error: Exception,
) -> int:
    print(f"Codex apply failed for {target}: {type(error).__name__}", file=sys.stderr)
    print(
        "Previously applied targets: " + (", ".join(applied_targets) if applied_targets else "(none)"),
        file=sys.stderr,
    )
    print(
        "Codex targets not applied: " + (", ".join(pending_targets) if pending_targets else "(none)"),
        file=sys.stderr,
    )
    print(
        f"Backups: {backup_root}",
        file=sys.stderr,
    )
    return 1


def _render_entry_preview(entry, repo_root: Path, *, dry_run: bool, settings=None) -> tuple[bool, str | None]:
    source_path = repo_root / entry.source
    target_path = Path(entry.target).expanduser()
    source_bytes = settings.content if settings is not None else source_path.read_bytes()
    current_bytes = target_path.read_bytes() if target_path.exists() else None
    current_mode = _file_mode(target_path)
    desired_mode = int(entry.mode, 8)
    content_matches = current_bytes == source_bytes
    mode_matches = current_mode == desired_mode
    needs_change = not (content_matches and mode_matches)

    if settings is not None:
        status = "nochange" if not needs_change else "would apply"
        label = f"{entry.layer}: {entry.source} + {settings.fragment} -> {entry.target}"
        return needs_change, f"{status}: {label}"

    if dry_run:
        status = "nochange" if not needs_change else "would apply"
        return needs_change, f"{status}: {summarize_plan_line(entry)}"

    try:
        source_text = source_bytes.decode("utf-8")
        current_text = current_bytes.decode("utf-8") if current_bytes is not None else None
    except UnicodeDecodeError:
        lines = [summarize_plan_line(entry)]
        if not needs_change:
            lines.append("No changes needed")
            return needs_change, "\n".join(lines)

        lines.append(f"Binary file: {entry.target} <- {entry.source}")
        if content_matches and not mode_matches:
            lines.append(f"Mode change: {current_mode:04o} -> {desired_mode:04o}")
        return needs_change, "\n".join(lines)

    lines = [summarize_plan_line(entry)]
    if not needs_change:
        lines.append("No changes needed")
        return needs_change, "\n".join(lines)

    lines.append(render_text_diff(entry.target, entry.source, current_text, source_text))
    if current_text is not None and content_matches and not mode_matches:
        lines.append(f"Mode change: {current_mode:04o} -> {desired_mode:04o}")
    return needs_change, "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--context", choices=("local", "remote"))
    parser.add_argument("--private")
    parser.add_argument("--hosts")
    parser.add_argument("--host-name")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--only")
    parser.add_argument("--yes", action="store_true")
    args = parser.parse_args()

    if args.host_name and not args.hosts:
        parser.error("--host-name requires --hosts")

    context = detect_context(args.context, dict(os.environ))
    entries = load_manifest(ROOT / "manifest" / "base.tsv", "base")
    private_root = None
    host_root = None
    if args.private:
        private_root = Path(args.private).expanduser()
        entries += load_manifest(private_root / "manifest" / "private.tsv", "private")
    if args.hosts:
        host_root = Path(args.hosts).expanduser()
        resolved_host = _resolve_host_name(args.host_name)
        host_manifest = host_root / "manifest" / f"{resolved_host}.tsv"
        if not host_manifest.exists():
            parser.error(f"Host manifest not found: {host_manifest}")
        entries += load_manifest(host_manifest, "host")
    codex_plans: list[tuple[str, CodexFilePlan]] = []
    if _matches_paths(args.only, CODEX_CONFIG_TARGET, PUBLIC_FRAGMENT, PRIVATE_FRAGMENT, PRIVATE_LOCAL_FRAGMENT):
        try:
            codex_plans.append(("codex", plan_codex_config(ROOT, private_root, context=context)))
        except ValueError as exc:
            parser.error(str(exc))
    report = build_plan_report(entries, context=context)
    filtered_plan = {
        target: entry
        for target, entry in report.selected.items()
        if _matches_only(entry, args.only)
    }
    filtered_overridden: list[ManifestEntry] = []
    for _, overridden_entries in report.overridden.items():
        for entry in overridden_entries:
            if _matches_only(entry, args.only):
                filtered_overridden.append(entry)

    # Plan every selected Codex file before any generic manifest write.
    generic_plan = {}
    settings_plans = {}
    for target, entry in filtered_plan.items():
        target_path = Path(entry.target).expanduser()
        if target_path.parent == Path.home() / ".codex" and target_path.name.endswith(".config.toml"):
            repo_root = _resolve_repo_root(entry, base_root=ROOT, private_root=private_root, host_root=host_root)
            source_path = repo_root / entry.source
            try:
                codex_plans.append((entry.layer, plan_codex_runtime(
                    source_path.read_text(encoding="utf-8"),
                    target_path=target_path,
                    source_label=entry.source,
                    target_label=entry.target,
                )))
            except ValueError as exc:
                parser.error(str(exc))
        else:
            try:
                settings = plan_private_settings(entry, base_root=ROOT, private_root=private_root)
            except ValueError as exc:
                parser.error(str(exc))
            if settings is not None:
                settings_plans[target] = settings
            generic_plan[target] = entry

    if _should_plan_codex_agents(private_root, args.only):
        try:
            codex_plans.append(("codex-agents", plan_codex_agents(private_root, base_root=ROOT, context=context)))
        except ValueError as exc:
            parser.error(str(exc))

    backup_root = Path.home() / ".dotfiles-backup" / datetime.now().strftime("%Y%m%d-%H%M%S")
    applied = 0
    applied_targets: list[str] = []
    skipped = 0
    nochange = 0
    for entry in generic_plan.values():
        repo_root = _resolve_repo_root(entry, base_root=ROOT, private_root=private_root, host_root=host_root)
        settings = settings_plans.get(entry.target)
        needs_change, preview = _render_entry_preview(entry, repo_root=repo_root, dry_run=args.dry_run, settings=settings)
        print(preview)
        if not needs_change:
            nochange += 1
            continue
        if args.dry_run:
            continue
        if not args.yes:
            answer = _confirm_change("Apply this change? [y]es/[n]o/[q]uit/[a]ll: ")
            if answer == "q":
                print(summarize_run(applied, skipped, nochange, len(filtered_overridden), args.dry_run))
                return 1
            if answer == "n":
                skipped += 1
                continue
            if answer == "a":
                args.yes = True
        apply_entry(entry, repo_root=repo_root, backup_root=backup_root,
                    content=settings.content if settings is not None else None)
        applied += 1
        applied_targets.append(entry.target)
    for index, (label, plan) in enumerate(codex_plans):
        try:
            status = apply_codex_file(plan, backup_root=backup_root, dry_run=True)
            print(summarize_generated_line(label, plan.source_label, plan.target_label, status=status.replace("_", " ")))
            if plan.changed_keys:
                print("  managed settings changed: " + ", ".join(plan.changed_keys))
            if plan.preserved_keys:
                print("  existing settings retained: " + ", ".join(plan.preserved_keys))
            if status == "would_apply" and not args.dry_run:
                answer = "y" if args.yes else _confirm_change(
                    f"Apply this Codex file change ({plan.target_label})? [y]es/[n]o/[q]uit/[a]ll: "
                )
                if answer == "q":
                    print(summarize_run(applied, skipped, nochange, len(filtered_overridden), args.dry_run))
                    return 1
                if answer == "n":
                    skipped += 1
                    status = "skipped"
                else:
                    if answer == "a":
                        args.yes = True
                    status = apply_codex_file(plan, backup_root=backup_root, dry_run=False)
                print(summarize_generated_line(label, plan.source_label, plan.target_label, status=status))
        except Exception as exc:
            pending = [pending_plan.target_label for _, pending_plan in codex_plans[index:]]
            return _report_codex_apply_failure(plan.target_label, applied_targets, pending, backup_root, exc)
        if status == "applied":
            applied += 1
            applied_targets.append(plan.target_label)
        elif status == "nochange":
            nochange += 1
    for entry in filtered_overridden:
        if args.dry_run:
            print(summarize_overridden_line(entry))
    print(summarize_run(applied, skipped, nochange, len(filtered_overridden), args.dry_run))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
