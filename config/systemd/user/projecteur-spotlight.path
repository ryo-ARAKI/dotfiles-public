[Unit]
Description=Start Projecteur when Logitech Spotlight is connected

[Path]
PathExistsGlob=/dev/input/by-id/usb-Logitech_USB_Receiver-event-if01
PathExistsGlob=/dev/input/by-id/usb-Logitech_USB_Receiver-if01-event-mouse
PathExistsGlob=/dev/input/by-id/usb-Logitech_USB_Receiver-if03-event-mouse
Unit=projecteur.service

[Install]
WantedBy=default.target
